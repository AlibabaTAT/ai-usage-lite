#include <winuser.h>
1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
FILEVERSION 0,3,4,0
PRODUCTVERSION 0,3,4,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "FileDescription", "AI Usage Lite"
      VALUE "ProductName", "AI Usage Lite"
      VALUE "FileVersion", "0.3.4"
      VALUE "ProductVersion", "0.3.4"
      VALUE "OriginalFilename", "AI-Usage-Lite.exe"
      VALUE "LegalCopyright", "MIT. Portions (C) 2026 Code Zeno Pty Ltd"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END
